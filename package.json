{
  "name": "aws-app-deployer",
  "productName": "AWS App Deployer",
  "version": "0.1.0",
  "description": "Local desktop application that deploys a Dockerfile or Compose project to AWS ECS Fargate behind a public load balancer.",
  "author": "Ding-Ding-Projects",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/backend/*.test.js tests/main/*.test.js tests/renderer/*.test.js tests/web/*.test.js",
    "screenshots": "electron . --screenshots=screenshots",
    "dist:win": "electron-builder --win --publish never",
    "icons": "node scripts/build-icons.mjs",
    "web:start": "node src/web/server.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.18.0",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "io.github.dingdingprojects.awsappdeployer",
    "productName": "AWS App Deployer",
    "files": [
      "src/**/*",
      "docs/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "icon": "build/icon.ico",
    "squirrelWindows": {
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/aws-app-deployer/main/build/icon.ico",
      "artifactName": "AWS-App-Deployer-Setup-${version}.${ext}",
      "name": "AWSAppDeployer"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
